# Avtoservis Selan — public Supabase client (browser)
# Copy to .env.local and fill in values from the Supabase project settings.
# Do not put service-role or other secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side trusted origin for one-time missing-data links (HTTPS outside isolated CI).
COMPLETION_PUBLIC_ORIGIN=
# Public application origin for same-origin checks (HTTPS outside isolated CI).
PUBLIC_APP_ORIGIN=
# Server-only key for verified manual Quibi evidence writes. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Quibi test credentials; never commit values or expose to browser code.
QUIBI_DEV_USERNAME=
QUIBI_DEV_PASSWORD=
# Reviewed branch Preview: APP_ENV=preproduction, QUIBI_MODE=dev,
# SELAN_FIXED_PRICE_V1=1. Keep Quibi credentials server-only.
# Vercel supplies VERCEL_URL / VERCEL_BRANCH_URL; never set remote demo flags.

# Isolated Vercel Preview demo only. Never combine with production Supabase.
# SELAN_REMOTE_DEMO=1
# NEXT_PUBLIC_SELAN_REMOTE_DEMO=1
# SELAN_DEMO_SUPABASE_PROJECT_REF=

# Optional approved server-only OpenAI intake analysis; model must support structured outputs.
# Set both on Selan DEV Preview; never use NEXT_PUBLIC or commit real values.
OPENAI_API_KEY=
SELAN_AI_MODEL=

# Server only: comma-separated explicitly approved DEV mailboxes.
# When omitted, the existing QUIBI_DEV_TEST_RECIPIENT remains the sole allowed recipient.
# Add Tadej only after he confirms the exact address. Never use NEXT_PUBLIC.
# QUIBI_DEV_TEST_RECIPIENTS=online.gold100@gmail.com
